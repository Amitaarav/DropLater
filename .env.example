# Runtime
NODE_ENV=development

# API service
API_PORT=3000

# Sink (webhook receiver)
SINK_PORT=4000

# MongoDB
MONGO_URL=mongodb://mongo:27017/app

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=            # optional

# Queues
QUEUE_EVENTS=events

# Worker -> Sink delivery
WEBHOOK_URL=http://sink:4000/webhook

# Logs
LOG_LEVEL=info
